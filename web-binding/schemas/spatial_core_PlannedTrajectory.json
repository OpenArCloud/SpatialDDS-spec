  "required": [
    "agent_id",
    "plan_id",
    "plan_revision",
    "frame_ref",
    "waypoints",
    "has_goal_pose",
    "goal_pose",
    "has_horizon_sec",
    "horizon_sec",
    "has_replan_rate_hz",
    "replan_rate_hz",
    "stamp",
    "schema_version"
  ],
  "title": "spatial.core.PlannedTrajectory",
  "type": "object"
}
