{
  "$defs": {
    "builtin_Time": {
      "additionalProperties": true,
      "properties": {
        "nanosec": {
          "maximum": 4294967295,
          "minimum": 0,
          "type": "integer"
        },
        "sec": {
          "pattern": "^-?\\d+$",
          "type": "string"
        }
      },
      "required": [
        "sec",
        "nanosec"
      ],
      "type": "object"
    },
    "spatial_common_FrameRef": {
      "additionalProperties": true,
      "properties": {
        "coord_convention": {
          "enum": [
            "ENU",
            "CV",
            "GRAPHICS",
            "UNITY_LH",
            "NED",
            "OTHER"
          ],
          "type": "string"
        },
        "display_unit": {
          "type": "string"
        },
        "fqn": {
          "type": "string"
        },
        "has_coord_convention": {
          "type": "boolean"
        },
        "has_scale": {
          "type": "boolean"
        },
        "meters_per_unit": {
          "type": "number"
        },
        "scale_status": {
          "enum": [
            "SCALE_UNKNOWN",
            "SCALE_DECLARED",
            "SCALE_DERIVED"
          ],
          "type": "string"
        },
        "uuid": {
          "type": "string"
        }
      },
      "required": [
        "uuid",
        "fqn",
        "has_coord_convention",
        "coord_convention",
        "has_scale",
        "scale_status",
        "meters_per_unit",
        "display_unit"
      ],
      "type": "object"
    },
    "spatial_core_PlannedWaypoint": {
      "additionalProperties": true,
      "properties": {
        "confidence": {
          "type": "number"
        },
        "has_confidence": {
          "type": "boolean"
        },
        "has_uncertainty": {
          "type": "boolean"
        },
        "has_velocity": {
          "type": "boolean"
        },
        "pose": {
          "$ref": "#/$defs/spatial_core_PoseSE3"
        },
        "position_uncertainty_m": {
          "type": "number"
        },
        "stamp": {
          "$ref": "#/$defs/builtin_Time"
        },
        "velocity": {
          "items": {
            "type": "number"
          },
          "maxItems": 3,
          "minItems": 3,
          "type": "array"
        }
      },
      "required": [
        "pose",
        "stamp",
        "has_velocity",
        "velocity",
        "has_uncertainty",
        "position_uncertainty_m",
        "has_confidence",
        "confidence"
      ],
      "type": "object"
    },
    "spatial_core_PoseSE3": {
      "additionalProperties": true,
      "properties": {
        "q": {
          "items": {
            "type": "number"
          },
          "maxItems": 4,
          "minItems": 4,
          "type": "array"
        },
        "t": {
          "items": {
            "type": "number"
          },
          "maxItems": 3,
          "minItems": 3,
          "type": "array"
        }
      },
      "required": [
        "t",
        "q"
      ],
      "type": "object"
    }
  },
  "$id": "spatialdds:webjson:spatial.core.PlannedTrajectory",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "agent_id": {
      "type": "string"
    },
    "frame_ref": {
      "$ref": "#/$defs/spatial_common_FrameRef"
    },
    "goal_pose": {
      "$ref": "#/$defs/spatial_core_PoseSE3"
    },
    "has_goal_pose": {
      "type": "boolean"
    },
    "has_horizon_sec": {
      "type": "boolean"
    },
    "has_replan_rate_hz": {
      "type": "boolean"
    },
    "horizon_sec": {
      "type": "number"
    },
    "plan_id": {
      "type": "string"
    },
    "plan_revision": {
      "maximum": 4294967295,
      "minimum": 0,
      "type": "integer"
    },
    "replan_rate_hz": {
      "type": "number"
    },
    "schema_version": {
      "type": "string"
    },
    "stamp": {
      "$ref": "#/$defs/builtin_Time"
    },
    "waypoints": {
      "items": {
