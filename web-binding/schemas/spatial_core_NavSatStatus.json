      "type": "number"
    },
    "diff_age_s": {
      "type": "number"
    },
    "diff_station_id": {
      "maximum": 65535,
      "minimum": 0,
      "type": "integer"
    },
    "fix_type": {
      "enum": [
        "NO_FIX",
        "FIX_2D",
        "FIX_3D",
        "DGPS",
        "RTK_FLOAT",
        "RTK_FIXED",
        "SBAS",
        "DEAD_RECKONING",
        "UNKNOWN_FIX"
      ],
      "type": "string"
    },
    "gnss_id": {
      "type": "string"
    },
    "has_diff_age": {
      "type": "boolean"
    },
    "has_dop": {
      "type": "boolean"
    },
    "has_velocity": {
      "type": "boolean"
    },
    "hdop": {
      "type": "number"
    },
    "num_satellites": {
      "maximum": 65535,
      "minimum": 0,
