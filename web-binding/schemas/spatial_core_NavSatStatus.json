    },
    "pdop": {
      "type": "number"
    },
    "schema_version": {
      "type": "string"
    },
    "service": {
      "maximum": 65535,
      "minimum": 0,
      "type": "integer"
    },
    "speed_mps": {
      "type": "number"
    },
    "stamp": {
      "$ref": "#/$defs/builtin_Time"
    },
    "vdop": {
      "type": "number"
    }
  },
  "required": [
    "gnss_id",
    "fix_type",
    "service",
    "num_satellites",
    "has_dop",
    "pdop",
    "hdop",
    "vdop",
    "has_velocity",
    "speed_mps",
    "course_deg",
    "has_diff_age",
