{
  "$defs": {
    "builtin_Time": {
      "additionalProperties": true,
      "properties": {
        "nanosec": {
          "maximum": 4294967295,
          "minimum": 0,
          "type": "integer"
        },
        "sec": {
          "pattern": "^-?\\d+$",
          "type": "string"
        }
      },
      "required": [
        "sec",
        "nanosec"
      ],
      "type": "object"
    },
    "spatial_common_FrameRef": {
      "additionalProperties": true,
      "properties": {
        "coord_convention": {
          "enum": [
            "ENU",
            "CV",
            "GRAPHICS",
            "UNITY_LH",
            "NED",
            "OTHER"
          ],
          "type": "string"
        },
        "display_unit": {
          "type": "string"
        },
        "fqn": {
          "type": "string"
        },
        "has_coord_convention": {
          "type": "boolean"
        },
        "has_scale": {
          "type": "boolean"
        },
        "meters_per_unit": {
          "type": "number"
        },
        "scale_status": {
          "enum": [
            "SCALE_UNKNOWN",
            "SCALE_DECLARED",
            "SCALE_DERIVED"
          ],
          "type": "string"
        },
        "uuid": {
          "type": "string"
        }
      },
      "required": [
        "uuid",
        "fqn",
        "has_coord_convention",
        "coord_convention",
        "has_scale",
        "scale_status",
        "meters_per_unit",
        "display_unit"
      ],
      "type": "object"
    }
  },
  "$id": "spatialdds:webjson:spatial.slam_frontend.CameraInfo",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "camera_id": {
      "type": "string"
    },
    "cx": {
      "type": "number"
    },
    "cy": {
      "type": "number"
    },
    "dist": {
      "items": {
        "type": "number"
      },
      "maxItems": 8,
      "type": "array"
    },
    "dist_kind": {
      "enum": [
        "NONE",
        "RADTAN",
        "EQUIDISTANT",
        "KANNALA_BRANDT"
      ],
      "type": "string"
    },
    "frame_ref": {
      "$ref": "#/$defs/spatial_common_FrameRef"
    },
    "fx": {
      "type": "number"
    },
    "fy": {
      "type": "number"
    },
    "height": {
      "maximum": 4294967295,
      "minimum": 0,
      "type": "integer"
    },
    "stamp": {
      "$ref": "#/$defs/builtin_Time"
    },
    "width": {
      "maximum": 4294967295,
      "minimum": 0,
      "type": "integer"
    }
  },
  "required": [
    "camera_id",
    "width",
    "height",
    "fx",
    "fy",
    "cx",
    "cy",
    "dist_kind",
    "dist",
    "frame_ref",
    "stamp"
  ],
  "title": "spatial.slam_frontend.CameraInfo",
  "type": "object"
}
