    },
    "accel_random_walk": {
      "type": "number"
    },
    "frame_ref": {
      "$ref": "#/$defs/spatial_common_FrameRef"
    },
    "gyro_noise_density": {
      "type": "number"
    },
    "gyro_random_walk": {
      "type": "number"
    },
    "imu_id": {
      "type": "string"
    },
    "stamp": {
