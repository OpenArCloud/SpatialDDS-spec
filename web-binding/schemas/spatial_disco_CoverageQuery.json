  "$id": "spatialdds:webjson:spatial.disco.CoverageQuery",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "coverage": {
      "items": {
        "$ref": "#/$defs/spatial_disco_CoverageElement"
      },
      "maxItems": 4,
      "type": "array"
    },
    "coverage_eval_time": {
      "$ref": "#/$defs/builtin_Time"
    },
    "coverage_frame_ref": {
      "$ref": "#/$defs/spatial_common_FrameRef"
    },
    "filter": {
      "$ref": "#/$defs/spatial_disco_CoverageFilter"
    },
    "has_coverage_eval_time": {
      "type": "boolean"
    },
    "has_filter": {
      "type": "boolean"
    },
    "query_id": {
      "type": "string"
    },
    "reply_topic": {
      "type": "string"
    },
    "stamp": {
      "$ref": "#/$defs/builtin_Time"
    },
    "ttl_sec": {
      "maximum": 4294967295,
      "minimum": 0,
      "type": "integer"
    }
  },
  "required": [
    "query_id",
    "coverage",
    "coverage_frame_ref",
    "has_coverage_eval_time",
    "coverage_eval_time",
    "has_filter",
    "filter",
    "reply_topic",
    "stamp",
    "ttl_sec"
  ],
  "title": "spatial.disco.CoverageQuery",
  "type": "object"
}
