      "required": [
        "stream_id",
        "frame_seq",
        "hdr",
        "sweep_type",
        "power",
        "beam_indices",
        "has_best_beam",
        "best_beam_idx",
        "best_beam_power",
        "has_blockage_state",
        "is_blocked",
        "blockage_confidence",
        "has_snr_db",
        "snr_db",
        "has_quality",
        "quality"
      ],
      "type": "object"
    }
  },
  "$id": "spatialdds:webjson:spatial.sensing.rf_beam.RfBeamArraySet",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "arrays": {
      "items": {
        "$ref": "#/$defs/spatial_sensing_rf_beam_RfBeamFrame"
      },
      "maxItems": 8,
      "type": "array"
    },
    "frame_seq": {
      "pattern": "^\\d+$",
      "type": "string"
    },
    "has_overall_best": {
      "type": "boolean"
    },
    "overall_best_array_idx": {
      "maximum": 65535,
      "minimum": 0,
      "type": "integer"
    },
    "overall_best_beam_idx": {
      "maximum": 65535,
      "minimum": 0,
      "type": "integer"
    },
    "overall_best_power": {
      "type": "number"
    },
    "set_id": {
      "type": "string"
    },
    "stamp": {
      "$ref": "#/$defs/builtin_Time"
    }
  },
  "required": [
    "set_id",
    "frame_seq",
    "stamp",
    "arrays",
    "has_overall_best",
    "overall_best_array_idx",
    "overall_best_beam_idx",
    "overall_best_power"
  ],
  "title": "spatial.sensing.rf_beam.RfBeamArraySet",
  "type": "object"
}
