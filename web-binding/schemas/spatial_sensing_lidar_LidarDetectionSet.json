{
  "$defs": {
    "builtin_Time": {
      "additionalProperties": true,
      "properties": {
        "nanosec": {
          "maximum": 4294967295,
          "minimum": 0,
          "type": "integer"
        },
        "sec": {
          "pattern": "^-?\\d+$",
          "type": "string"
        }
      },
      "required": [
        "sec",
        "nanosec"
      ],
      "type": "object"
    },
    "spatial_common_FrameRef": {
      "additionalProperties": true,
      "properties": {
        "coord_convention": {
          "enum": [
            "ENU",
            "CV",
            "GRAPHICS",
            "UNITY_LH",
            "NED",
            "OTHER"
          ],
          "type": "string"
        },
        "display_unit": {
          "type": "string"
        },
        "fqn": {
          "type": "string"
        },
        "has_coord_convention": {
          "type": "boolean"
        },
        "has_scale": {
          "type": "boolean"
        },
        "meters_per_unit": {
          "type": "number"
        },
        "scale_status": {
          "enum": [
            "SCALE_UNKNOWN",
            "SCALE_DECLARED",
            "SCALE_DERIVED"
          ],
          "type": "string"
        },
        "uuid": {
          "type": "string"
        }
      },
      "required": [
        "uuid",
        "fqn",
        "has_coord_convention",
        "coord_convention",
        "has_scale",
        "scale_status",
        "meters_per_unit",
        "display_unit"
      ],
      "type": "object"
    },
    "spatial_sensing_lidar_LidarDetection": {
      "additionalProperties": true,
      "properties": {
        "intensity": {
          "type": "number"
        },
        "quality": {
          "type": "number"
        },
        "ring": {
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "xyz_m": {
          "items": {
            "type": "number"
          },
          "maxItems": 3,
          "minItems": 3,
          "type": "array"
        }
      },
      "required": [
        "xyz_m",
        "intensity",
        "ring",
        "quality"
      ],
      "type": "object"
    }
  },
  "$id": "spatialdds:webjson:spatial.sensing.lidar.LidarDetectionSet",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "dets": {
      "items": {
        "$ref": "#/$defs/spatial_sensing_lidar_LidarDetection"
      },
      "maxItems": 256,
      "type": "array"
    },
    "frame_ref": {
      "$ref": "#/$defs/spatial_common_FrameRef"
    },
    "frame_seq": {
      "pattern": "^\\d+$",
      "type": "string"
    },
    "stamp": {
      "$ref": "#/$defs/builtin_Time"
    },
    "stream_id": {
      "type": "string"
    }
  },
  "required": [
    "stream_id",
    "frame_seq",
    "frame_ref",
    "dets",
    "stamp"
  ],
  "title": "spatial.sensing.lidar.LidarDetectionSet",
  "type": "object"
}
