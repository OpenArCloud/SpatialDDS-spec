{
  "$defs": {
    "builtin_Time": {
      "additionalProperties": true,
      "properties": {
        "nanosec": {
          "maximum": 4294967295,
          "minimum": 0,
          "type": "integer"
        },
        "sec": {
          "pattern": "^-?\\d+$",
          "type": "string"
        }
      },
      "required": [
        "sec",
        "nanosec"
      ],
      "type": "object"
    },
    "spatial_common_FrameRef": {
      "additionalProperties": true,
      "properties": {
        "coord_convention": {
          "enum": [
            "ENU",
            "CV",
            "GRAPHICS",
            "UNITY_LH",
            "NED",
            "OTHER"
          ],
          "type": "string"
        },
        "display_unit": {
          "type": "string"
        },
        "fqn": {
          "type": "string"
        },
        "has_coord_convention": {
          "type": "boolean"
        },
        "has_scale": {
          "type": "boolean"
        },
        "meters_per_unit": {
          "type": "number"
        },
        "scale_status": {
          "enum": [
            "SCALE_UNKNOWN",
            "SCALE_DECLARED",
            "SCALE_DERIVED"
          ],
          "type": "string"
        },
        "uuid": {
          "type": "string"
        }
      },
      "required": [
        "uuid",
        "fqn",
        "has_coord_convention",
        "coord_convention",
        "has_scale",
        "scale_status",
        "meters_per_unit",
        "display_unit"
      ],
      "type": "object"
    },
    "spatial_core_PoseSE3": {
      "additionalProperties": true,
      "properties": {
        "q": {
          "items": {
            "type": "number"
          },
          "maxItems": 4,
          "minItems": 4,
          "type": "array"
        },
        "t": {
          "items": {
            "type": "number"
          },
          "maxItems": 3,
          "minItems": 3,
          "type": "array"
        }
      },
      "required": [
        "t",
        "q"
      ],
      "type": "object"
    },
    "spatial_disco_ValidityWindow": {
      "additionalProperties": true,
      "properties": {
        "from": {
          "$ref": "#/$defs/builtin_Time"
        },
        "seconds": {
          "maximum": 4294967295,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "from",
        "seconds"
      ],
      "type": "object"
    }
  },
  "$id": "spatialdds:webjson:spatial.disco.Transform",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "from": {
      "$ref": "#/$defs/spatial_common_FrameRef"
    },
    "has_validity": {
      "type": "boolean"
    },
    "pose": {
      "$ref": "#/$defs/spatial_core_PoseSE3"
    },
    "stamp": {
      "$ref": "#/$defs/builtin_Time"
    },
    "to": {
      "$ref": "#/$defs/spatial_common_FrameRef"
    },
    "validity": {
      "$ref": "#/$defs/spatial_disco_ValidityWindow"
    }
  },
  "required": [
    "from",
    "to",
    "pose",
    "stamp",
    "has_validity",
    "validity"
  ],
  "title": "spatial.disco.Transform",
  "type": "object"
}
