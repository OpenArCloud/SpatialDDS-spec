{
  "$defs": {
    "builtin_Time": {
      "additionalProperties": true,
      "properties": {
        "nanosec": {
          "maximum": 4294967295,
          "minimum": 0,
          "type": "integer"
        },
        "sec": {
          "pattern": "^-?\\d+$",
          "type": "string"
        }
      },
      "required": [
        "sec",
        "nanosec"
      ],
      "type": "object"
    },
    "spatial_common_FrameRef": {
      "additionalProperties": true,
      "properties": {
        "coord_convention": {
          "enum": [
            "ENU",
            "CV",
            "GRAPHICS",
            "UNITY_LH",
            "NED",
            "OTHER"
          ],
          "type": "string"
        },
        "display_unit": {
          "type": "string"
        },
        "fqn": {
          "type": "string"
        },
        "has_coord_convention": {
          "type": "boolean"
        },
        "has_scale": {
          "type": "boolean"
        },
        "meters_per_unit": {
          "type": "number"
        },
        "scale_status": {
          "enum": [
            "SCALE_UNKNOWN",
            "SCALE_DECLARED",
            "SCALE_DERIVED"
          ],
          "type": "string"
        },
        "uuid": {
          "type": "string"
        }
      },
      "required": [
        "uuid",
        "fqn",
        "has_coord_convention",
        "coord_convention",
        "has_scale",
        "scale_status",
        "meters_per_unit",
        "display_unit"
      ],
      "type": "object"
    },
    "spatial_core_Aabb3": {
      "additionalProperties": true,
      "properties": {
        "max_xyz": {
          "items": {
            "type": "number"
          },
          "maxItems": 3,
          "minItems": 3,
          "type": "array"
        },
        "min_xyz": {
          "items": {
            "type": "number"
          },
          "maxItems": 3,
          "minItems": 3,
          "type": "array"
        }
      },
      "required": [
        "min_xyz",
        "max_xyz"
      ],
      "type": "object"
    },
    "spatial_core_PoseSE3": {
      "additionalProperties": true,
      "properties": {
        "q": {
          "items": {
            "type": "number"
          },
          "maxItems": 4,
          "minItems": 4,
          "type": "array"
        },
        "t": {
          "items": {
            "type": "number"
          },
          "maxItems": 3,
          "minItems": 3,
          "type": "array"
        }
      },
      "required": [
        "t",
        "q"
      ],
      "type": "object"
    },
    "spatial_disco_Capabilities": {
      "additionalProperties": true,
      "properties": {
        "features": {
          "items": {
            "type": "string"
          },
          "maxItems": 64,
          "type": "array"
        },
        "preferred_profiles": {
          "items": {
            "type": "string"
          },
          "maxItems": 32,
          "type": "array"
        },
        "supported_profiles": {
          "items": {
            "$ref": "#/$defs/spatial_disco_ProfileSupport"
          },
          "maxItems": 64,
          "type": "array"
        }
      },
      "required": [
        "supported_profiles",
        "preferred_profiles",
        "features"
      ],
      "type": "object"
    },
    "spatial_disco_CoverageElement": {
      "additionalProperties": true,
      "properties": {
        "_global": {
          "type": "boolean"
        },
        "aabb": {
          "$ref": "#/$defs/spatial_core_Aabb3"
        },
        "bbox": {
          "items": {
            "type": "number"
          },
          "maxItems": 4,
          "minItems": 4,
          "type": "array"
        },
        "circle_center": {
          "items": {
            "type": "number"
          },
          "maxItems": 3,
          "minItems": 3,
          "type": "array"
        },
        "circle_radius_m": {
          "type": "number"
        },
        "coverage_window_end": {
          "$ref": "#/$defs/builtin_Time"
        },
        "coverage_window_start": {
          "$ref": "#/$defs/builtin_Time"
        },
        "crs": {
          "type": "string"
        },
        "frame_ref": {
          "$ref": "#/$defs/spatial_common_FrameRef"
        },
        "has_aabb": {
          "type": "boolean"
        },
        "has_bbox": {
          "type": "boolean"
        },
        "has_circle": {
          "type": "boolean"
        },
        "has_coverage_window": {
          "type": "boolean"
        },
        "has_crs": {
          "type": "boolean"
        },
        "has_frame_ref": {
          "type": "boolean"
        }
      },
      "required": [
        "has_crs",
        "crs",
        "has_bbox",
        "bbox",
        "has_aabb",
        "aabb",
        "_global",
        "has_frame_ref",
        "frame_ref",
        "has_coverage_window",
        "coverage_window_start",
        "coverage_window_end",
        "has_circle",
        "circle_center",
        "circle_radius_m"
      ],
      "type": "object"
    },
    "spatial_disco_KV": {
      "additionalProperties": true,
      "properties": {
        "key": {
          "type": "string"
        },
        "value": {
          "type": "string"
        }
      },
      "required": [
        "key",
        "value"
      ],
      "type": "object"
    },
    "spatial_disco_ProfileSupport": {
      "additionalProperties": true,
      "properties": {
        "major": {
          "maximum": 4294967295,
          "minimum": 0,
          "type": "integer"
        },
        "max_minor": {
          "maximum": 4294967295,
          "minimum": 0,
          "type": "integer"
        },
        "min_minor": {
          "maximum": 4294967295,
          "minimum": 0,
          "type": "integer"
        },
        "name": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "major",
        "min_minor",
        "max_minor"
      ],
      "type": "object"
    },
    "spatial_disco_TopicMeta": {
      "additionalProperties": true,
      "properties": {
        "max_chunk_bytes": {
          "maximum": 4294967295,
          "minimum": 0,
          "type": "integer"
        },
        "name": {
          "type": "string"
        },
        "qos_profile": {
          "type": "string"
        },
        "target_rate_hz": {
          "type": "number"
        },
        "type": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "type",
        "version",
        "qos_profile",
        "target_rate_hz",
        "max_chunk_bytes"
      ],
      "type": "object"
    },
    "spatial_disco_Transform": {
      "additionalProperties": true,
      "properties": {
        "_from": {
          "$ref": "#/$defs/spatial_common_FrameRef"
        },
        "has_validity": {
          "type": "boolean"
        },
        "pose": {
          "$ref": "#/$defs/spatial_core_PoseSE3"
        },
        "stamp": {
          "$ref": "#/$defs/builtin_Time"
        },
        "to": {
          "$ref": "#/$defs/spatial_common_FrameRef"
        },
        "validity": {
          "$ref": "#/$defs/spatial_disco_ValidityWindow"
        }
      },
      "required": [
        "_from",
        "to",
        "pose",
        "stamp",
        "has_validity",
        "validity"
      ],
      "type": "object"
    },
    "spatial_disco_ValidityWindow": {
      "additionalProperties": true,
      "properties": {
        "_from": {
          "$ref": "#/$defs/builtin_Time"
        },
        "seconds": {
          "maximum": 4294967295,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "_from",
        "seconds"
      ],
      "type": "object"
    }
  },
  "$id": "spatialdds:webjson:spatial.disco.Announce",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "auth_hint": {
      "type": "string"
    },
    "caps": {
      "$ref": "#/$defs/spatial_disco_Capabilities"
    },
    "coverage": {
      "items": {
        "$ref": "#/$defs/spatial_disco_CoverageElement"
      },
      "maxItems": 16,
      "type": "array"
    },
    "coverage_eval_time": {
      "$ref": "#/$defs/builtin_Time"
    },
    "coverage_frame_ref": {
      "$ref": "#/$defs/spatial_common_FrameRef"
    },
    "coverage_source_ids": {
      "items": {
        "type": "string"
      },
      "maxItems": 16,
      "type": "array"
    },
    "has_coverage_eval_time": {
      "type": "boolean"
    },
    "hints": {
      "items": {
        "$ref": "#/$defs/spatial_disco_KV"
      },
      "maxItems": 32,
      "type": "array"
    },
    "kind": {
      "enum": [
        "VPS",
        "MAPPING",
        "RELOCAL",
        "SEMANTICS",
        "STORAGE",
        "CONTENT",
        "ANCHOR_REGISTRY",
        "OTHER",
        "SENSING",
        "INFRASTRUCTURE",
        "FUSION"
      ],
      "type": "string"
    },
    "manifest_uri": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "org": {
      "type": "string"
    },
    "service_id": {
      "type": "string"
    },
    "stamp": {
      "$ref": "#/$defs/builtin_Time"
    },
    "topics": {
      "items": {
        "$ref": "#/$defs/spatial_disco_TopicMeta"
      },
      "maxItems": 128,
      "type": "array"
    },
    "transforms": {
      "items": {
        "$ref": "#/$defs/spatial_disco_Transform"
      },
      "maxItems": 8,
      "type": "array"
    },
    "ttl_sec": {
      "maximum": 4294967295,
      "minimum": 0,
      "type": "integer"
    },
    "version": {
      "type": "string"
    }
  },
  "required": [
    "service_id",
    "name",
    "kind",
    "version",
    "org",
    "hints",
    "caps",
    "topics",
    "coverage",
    "coverage_frame_ref",
    "has_coverage_eval_time",
    "coverage_eval_time",
    "transforms",
    "manifest_uri",
    "auth_hint",
    "stamp",
    "ttl_sec",
    "coverage_source_ids"
  ],
  "title": "spatial.disco.Announce",
  "type": "object"
}
