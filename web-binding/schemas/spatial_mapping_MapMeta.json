        "loop_closure_count",
        "has_mean_residual",
        "mean_residual",
        "has_max_drift_m",
        "max_drift_m",
        "has_coverage_pct",
        "coverage_pct",
        "has_keyframe_count",
        "keyframe_count",
        "has_landmark_count",
        "landmark_count"
      ],
      "type": "object"
    }
