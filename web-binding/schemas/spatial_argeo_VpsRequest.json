{
  "$defs": {
    "builtin_Time": {
      "additionalProperties": true,
      "properties": {
        "nanosec": {
          "maximum": 4294967295,
          "minimum": 0,
          "type": "integer"
        },
        "sec": {
          "pattern": "^-?\\d+$",
          "type": "string"
        }
      },
      "required": [
        "sec",
        "nanosec"
      ],
      "type": "object"
    },
    "spatial_argeo_QualityRequirements": {
      "additionalProperties": true,
      "properties": {
        "max_rmse_m": {
          "type": "number"
        },
        "min_confidence": {
          "type": "number"
        }
      },
      "required": [
        "max_rmse_m",
        "min_confidence"
      ],
      "type": "object"
    },
    "spatial_common_FrameRef": {
      "additionalProperties": true,
      "properties": {
        "coord_convention": {
          "enum": [
            "ENU",
            "CV",
            "GRAPHICS",
            "UNITY_LH",
            "NED",
            "OTHER"
          ],
          "type": "string"
        },
        "display_unit": {
          "type": "string"
        },
        "fqn": {
          "type": "string"
        },
        "has_coord_convention": {
          "type": "boolean"
        },
        "has_scale": {
          "type": "boolean"
        },
        "meters_per_unit": {
          "type": "number"
        },
        "scale_status": {
          "enum": [
            "SCALE_UNKNOWN",
            "SCALE_DECLARED",
            "SCALE_DERIVED"
          ],
          "type": "string"
        },
        "uuid": {
          "type": "string"
        }
      },
      "required": [
        "uuid",
        "fqn",
        "has_coord_convention",
        "coord_convention",
        "has_scale",
        "scale_status",
        "meters_per_unit",
        "display_unit"
      ],
      "type": "object"
    },
    "spatial_core_BlobRef": {
      "additionalProperties": true,
      "properties": {
        "blob_id": {
          "type": "string"
        },
        "checksum": {
          "type": "string"
        },
        "role": {
          "type": "string"
        }
      },
      "required": [
        "blob_id",
        "role",
        "checksum"
      ],
      "type": "object"
    },
    "spatial_core_CovMatrix": {
      "oneOf": [
        {
          "additionalProperties": true,
          "properties": {
            "type": {
              "const": "COV_NONE"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "additionalProperties": true,
          "properties": {
            "pos": {
              "items": {
                "type": "number"
              },
              "maxItems": 9,
              "minItems": 9,
              "type": "array"
            },
            "type": {
              "const": "COV_POS3"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "additionalProperties": true,
          "properties": {
            "pose": {
              "items": {
                "type": "number"
              },
              "maxItems": 36,
              "minItems": 36,
              "type": "array"
            },
            "type": {
              "const": "COV_POSE6"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "additionalProperties": true,
          "properties": {
            "rot": {
              "items": {
                "type": "number"
              },
              "maxItems": 9,
              "minItems": 9,
              "type": "array"
            },
            "type": {
              "const": "COV_ROT3"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "additionalProperties": true,
          "properties": {
            "pose_twist": {
              "items": {
                "type": "number"
              },
              "maxItems": 144,
              "minItems": 144,
              "type": "array"
            },
            "type": {
              "const": "COV_POSE6_TWIST6"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        }
      ]
    },
    "spatial_core_GeoPose": {
      "additionalProperties": true,
      "properties": {
        "alt_m": {
          "type": "number"
        },
        "cov": {
          "$ref": "#/$defs/spatial_core_CovMatrix"
        },
        "lat_deg": {
          "type": "number"
        },
        "lon_deg": {
          "type": "number"
        },
        "q": {
          "items": {
            "type": "number"
          },
          "maxItems": 4,
          "minItems": 4,
          "type": "array"
        },
        "stamp": {
          "$ref": "#/$defs/builtin_Time"
        }
      },
      "required": [
        "lat_deg",
        "lon_deg",
        "alt_m",
        "q",
        "stamp",
        "cov"
      ],
      "type": "object"
    }
  },
  "$id": "spatialdds:webjson:spatial.argeo.VpsRequest",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "client_frame_ref": {
      "$ref": "#/$defs/spatial_common_FrameRef"
    },
    "has_prior_geopose": {
      "type": "boolean"
    },
    "has_quality_requirements": {
      "type": "boolean"
    },
    "prior_geopose": {
      "$ref": "#/$defs/spatial_core_GeoPose"
    },
    "quality_requirements": {
      "$ref": "#/$defs/spatial_argeo_QualityRequirements"
    },
    "query_blobs": {
      "items": {
        "$ref": "#/$defs/spatial_core_BlobRef"
      },
      "maxItems": 8,
      "type": "array"
    },
    "query_id": {
      "type": "string"
    },
    "query_stream_id": {
      "type": "string"
    },
    "service_id": {
      "type": "string"
    },
    "stamp": {
      "$ref": "#/$defs/builtin_Time"
    }
  },
  "required": [
    "query_id",
    "service_id",
    "client_frame_ref",
    "has_prior_geopose",
    "prior_geopose",
    "query_blobs",
    "query_stream_id",
    "has_quality_requirements",
    "quality_requirements",
    "stamp"
  ],
  "title": "spatial.argeo.VpsRequest",
  "type": "object"
}
