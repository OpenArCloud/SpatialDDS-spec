        "nanosec": {
          "maximum": 4294967295,
          "minimum": 0,
          "type": "integer"
        },
        "sec": {
          "pattern": "^-?\\d+$",
          "type": "string"
        }
      },
      "required": [
        "sec",
        "nanosec"
      ],
      "type": "object"
    },
    "spatial_common_KV": {
      "additionalProperties": true,
      "properties": {
        "key": {
          "type": "string"
        },
        "value": {
          "type": "string"
        }
      },
      "required": [
        "key",
        "value"
      ],
      "type": "object"
    },
    "spatial_common_MetaKV": {
      "additionalProperties": true,
      "properties": {
        "entries": {
          "items": {
            "$ref": "#/$defs/spatial_common_KV"
          },
          "maxItems": 64,
          "type": "array"
        },
        "json": {
          "type": "string"
        },
        "namespace": {
          "type": "string"
        }
      },
      "required": [
        "namespace",
        "json",
        "entries"
      ],
      "type": "object"
    }
  },
