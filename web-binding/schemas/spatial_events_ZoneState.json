  "additionalProperties": true,
  "properties": {
    "active_alert": {
      "maximum": 4294967295,
      "minimum": 0,
      "type": "integer"
    },
    "active_critical": {
      "maximum": 4294967295,
      "minimum": 0,
      "type": "integer"
    },
    "active_info": {
      "maximum": 4294967295,
      "minimum": 0,
      "type": "integer"
    },
    "active_warning": {
      "maximum": 4294967295,
      "minimum": 0,
      "type": "integer"
    },
    "capacity": {
